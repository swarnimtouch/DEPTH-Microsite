# Laravel sends broadcast events to the local Reverb process.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=replace-with-app-id
REVERB_APP_KEY=replace-with-public-app-key
REVERB_APP_SECRET=replace-with-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser-facing WebSocket endpoint. For production, point these values to
# the HTTPS/WSS reverse proxy that forwards WebSocket traffic to port 8080.
REVERB_CLIENT_HOST=example.com
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https
REVERB_CLIENT_PATH=
